{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Keycloak": {
      "Authority": "http://localhost:8081/realms/clinic",
      "Audience": "clinic-api",
      "RequireHttpsMetadata": true
    }
  },
  "Authorization": {
    "AdminSubjects": []
  },
  "ClinicManagementSettings": {
    "DefaultAppointmentDurationMinutes": 20,
    "DefaultClinicStartTime": "08:00",
    "DefaultClinicEndTime": "16:00"
  }
}